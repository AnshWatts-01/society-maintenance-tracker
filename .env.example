# ─────────────────────────────────────────────────────────────
# Society Maintenance Tracker — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---------------------------------------------------
# Any Postgres works. Recommended free tier: Supabase (supabase.com) or Neon (neon.tech).
# Use the "connection pooling" URI for DATABASE_URL and the direct URI for DIRECT_URL
# (Prisma needs a direct, non-pooled connection to run migrations).
DATABASE_URL="postgresql://user:password@host:5432/society_tracker?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/society_tracker?schema=public"

# --- Auth ---------------------------------------------------------------------
# HMAC signing secret for session JWTs (native Web Crypto HS256, no jsonwebtoken dependency).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
# Session cookie lifetime, in seconds (default: 7 days)
AUTH_SESSION_TTL_SECONDS=604800

# --- Photo Storage (Supabase Storage, used over plain REST — no SDK dependency) ---
# Create a public "complaint-photos" bucket in your Supabase project's Storage tab.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon key is safe to expose to the browser (it is public by Supabase's own
# design); the server-only service role key must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="complaint-photos"

# --- Email (Resend, called via native fetch — no SDK dependency) --------------
# Sign up free at resend.com, verify a sending domain (or use their onboarding@resend.dev
# for testing), and create an API key.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Society Maintenance Tracker <notifications@yourdomain.com>"

# --- Scheduled overdue-sweep / notification-retry endpoint --------------------
# Shared secret required as a Bearer token on GET /api/cron/sweep.
# Vercel Cron (see vercel.json) and any manual/curl trigger must send this.
CRON_SECRET="replace-with-a-long-random-string"

# --- App -----------------------------------------------------------------------
# Public base URL of the deployed app (used in email links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default SLA threshold (days) seeded into SystemSetting on first run.
DEFAULT_OVERDUE_THRESHOLD_DAYS=3
